// ============================================================================
// windows-settings Zellij 0.46+ Configuration (Cross-Platform IDE & Agent Hub)
// ============================================================================
// Pillars I & VIII: Monochromatic UI chrome, frameless single-line BASE01
// dividers, top 1-line BASE02 compact-bar, collision-free 4-layer keybindings,
// and native OSC 7501 AI agent attention tracking.

theme "windows-settings"
pane_frames false
simplified_ui false
default_layout "ide-3pane"
default_shell "pwsh"
on_force_close "detach"
on_quit "detach"
scroll_buffer_size 50000
copy_on_select true
mouse_mode true
styled_underlines true
osc8_hyperlinks true
show_startup_tips false
show_release_notes false
session_serialization true
serialize_pane_viewport true
scrollback_lines_to_serialize 10000

ui {
    pane_frames {
        rounded_corners true
        hide_session_name false
        border_style "single"
        floating_border_style "single"
        floating_border_rounded_corners true
    }
}

plugins {
    tab-bar location="zellij:bars" {
        role "tab-bar"
    }
    status-bar location="zellij:bars" {
        role "status-bar"
    }
    strider location="zellij:strider"
    compact-bar location="zellij:bars" {
        role "compact-bar"
    }
    session-manager location="zellij:session-manager"
    welcome-screen location="zellij:session-manager" {
        welcome_screen true
    }
    filepicker location="zellij:strider" {
        cwd "/"
    }
    configuration location="zellij:configuration"
    plugin-manager location="zellij:plugin-manager"
    about location="zellij:about"
    context-menu location="zellij:context-menu"
    prompt location="zellij:prompt"
}

load_plugins {
    "zellij:bars" {
        role "link"
    }
}

// IDE Workspace Right-Click Context Menus (shortcuts auto-resolved by Zellij from keybinds)
context_menu {
    bar clear-defaults=true {
        item "Focus AI agent" { MoveFocus "Up"; MoveFocus "Left"; }
        item "Focus Editor" { MoveFocus "Up"; MoveFocus "Right"; }
        item "Focus Shell" { MoveFocus "Down"; }
        separator
        item "Session manager & inbox" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            }
        }
        item "Next attention agent" { GoToNextAttention; }
        item "Back to {}" { ToggleSession; }
        separator
        item "Toggle fullscreen zoom" { ToggleFocusFullscreen; }
        item "Toggle floating panes" { ToggleFloatingPanes; }
        item "Cycle swap layout" { NextSwapLayout; }
        item "New tab" { NewTab; }
        item "Rename session…" { SwitchToMode "RenameSession"; SessionNameInput 0; }
        item "Open in a Zellij terminal" { OpenSessionInTerminal; }
        separator
        item "Hide top bar" { HideBars; }
        item "Detach" { Detach; }
    }
    tab clear-defaults=true {
        item "Focus AI agent" { MoveFocus "Up"; MoveFocus "Left"; }
        item "Focus Editor" { MoveFocus "Up"; MoveFocus "Right"; }
        item "Focus Shell" { MoveFocus "Down"; }
        separator
        item "Session manager & inbox" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            }
        }
        item "Next attention agent" { GoToNextAttention; }
        separator
        item "New tab" { NewTab; }
        item "Rename tab…" { StartRenameTabByTabId; }
        item "Move left" { MoveTabByTabId "left"; }
        item "Move right" { MoveTabByTabId "right"; }
        item "Mute tab" toggled_label="Unmute tab" { MuteTabByTabId; }
        separator
        item "Close tab" { CloseTabById; }
    }
    pane {
        item "Paste" { PasteFromClipboardByPaneId; }
        separator
        item "New pane" { NewPane; }
        item "New floating pane" { NewFloatingPane; }
        separator
        item "Rename pane…" { StartRenamePaneByPaneId; }
        item "Fullscreen" toggled_label="Exit fullscreen" { ToggleFocusFullscreenByPaneId; }
        item "Make floating" toggled_label="Make tiled" { TogglePaneEmbedOrFloatingByPaneId; }
        item "Show titles in a row" toggled_label="Show titles in a column" { ToggleStackListOrientationByPaneId; }
        separator
        item "Watch pane" toggled_label="Stop watching" { WatchPaneByPaneId; }
        item "Mute pane" toggled_label="Unmute pane" { MutePaneByPaneId; }
        separator
        item "Close pane" { CloseFocusByPaneId; }
    }
    common clear-defaults=true {
        item "System monitor" {
            Run "cmd.exe" "/d" "/c" "ide.cmd" "--toggle-monitor" {
                background true
            }
        }
        item "Keybinding cheatsheet" {
            Run "cmd.exe" "/d" "/c" "ide.cmd" "--toggle-keys" {
                background true
            }
        }
        item "Show bars" { ShowBars; }
        item "Settings…" {
            LaunchOrFocusPlugin "configuration" {
                floating true
                move_to_focused_tab true
            }
        }
        separator
        item "Quit IDE workspace" {
            Run "ide.cmd" "--quit" {
                floating true
                close_on_exit true
            }
        }
    }
}

// Native OSC 7501 Agent Attention Inbox, Tray Badges & Desktop Notifications
attention {
    enabled true
    frame_markers true
    tab_markers true
    host_status true
    tray_icon true
    idle_rule "all"
    done_threshold_secs 10
    track_commands false
    idle_activity_secs 10
    idle_silence_secs 3
    startup_card "attention"
    desktop_notifications {
        needs_you true
        failed true
        done true
    }
    tray_badge {
        needs_you true
        failed true
        done true
        working true
        quiet false
        new_output false
    }
    // BEGIN WINDOWS-SETTINGS TRAY COLORS
    tray_badge_colors {
        needs_you "#CB4B16"
        failed "#DC322F"
        done "#859900"
        working "#268BD2"
        quiet "#586E75"
        new_output "#2AA198"
    }
    // END WINDOWS-SETTINGS TRAY COLORS
    notification_details true
}

// 1-Hop GPU Desktop Terminal (`ide --desktop` / `zellij terminal`)
terminal {
    font "MesloLGS Nerd Font Mono"
    font_size 11
    system_fonts true
    ligatures true
    cursor_style "block"
    cursor_blink false
    bell "visual"
    open_links true
    open_links_with_shift true
    shift_drag_selects true
    reuse_session_windows true
    startup_mode "remember"
    initial_columns 150
    initial_rows 44
    // BEGIN WINDOWS-SETTINGS TERMINAL THEME
    theme {
        foreground "#839496"
        background "#002B36"
        cursor "#839496"
        black "#073642"
        red "#DC322F"
        green "#859900"
        yellow "#B58900"
        blue "#268BD2"
        magenta "#D33682"
        cyan "#2AA198"
        white "#EEE8D5"
        bright_black "#586E75"
        bright_red "#CB4B16"
        bright_green "#586E75"
        bright_yellow "#657B83"
        bright_blue "#839496"
        bright_magenta "#6C71C4"
        bright_cyan "#93A1A1"
        bright_white "#FDF6E3"
    }
    // END WINDOWS-SETTINGS TERMINAL THEME
}

// 4-Layer Collision-Free Keybinding Hierarchy
//   Layer 1: Ctrl+* passed straight through to Neovim, shells & AI agents
//   Layer 2: Alt+* single-stroke IDE pane/session/attention navigation
//   Layer 3: Ctrl+b prefix mode matching home-settings/.tmux.conf muscle memory
//   Layer 4: Ctrl+b g enters Locked pass-through mode (Ctrl+g unlocks)
keybinds clear-defaults=true {
    normal {
    }

    locked {
        bind "Ctrl g" { SwitchToMode "Normal"; }
    }

    tmux {
        bind "Esc" "Enter" { SwitchToMode "Normal"; }
        bind "Ctrl b" { Write 2; SwitchToMode "Normal"; }
        bind "d" { Detach; }
        bind "s" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "Normal"
        }
        bind "S" "Shift s" { GoToNextAttention; SwitchToMode "Normal"; }
        bind "(" { GoToPreviousSession; SwitchToMode "Normal"; }
        bind ")" { GoToNextSession; SwitchToMode "Normal"; }
        bind "L" "Shift l" { ToggleSession; SwitchToMode "Normal"; }
        bind "|" "%" { NewPane "Right"; SwitchToMode "Normal"; }
        bind "-" "\"" { NewPane "Down"; SwitchToMode "Normal"; }
        bind "z" { ToggleFocusFullscreen; SwitchToMode "Normal"; }
        bind "f" { ToggleFloatingPanes; SwitchToMode "Normal"; }
        bind "c" { NewTab; SwitchToMode "Normal"; }
        bind "n" { GoToNextTab; SwitchToMode "Normal"; }
        bind "p" { GoToPreviousTab; SwitchToMode "Normal"; }
        bind "1" { GoToTab 1; SwitchToMode "Normal"; }
        bind "2" { GoToTab 2; SwitchToMode "Normal"; }
        bind "3" { GoToTab 3; SwitchToMode "Normal"; }
        bind "4" { GoToTab 4; SwitchToMode "Normal"; }
        bind "5" { GoToTab 5; SwitchToMode "Normal"; }
        bind "6" { GoToTab 6; SwitchToMode "Normal"; }
        bind "7" { GoToTab 7; SwitchToMode "Normal"; }
        bind "8" { GoToTab 8; SwitchToMode "Normal"; }
        bind "9" { GoToTab 9; SwitchToMode "Normal"; }
        bind "," { SwitchToMode "RenameTab"; TabNameInput 0; }
        bind "$" { SwitchToMode "RenameSession"; SessionNameInput 0; }
        bind "[" { SwitchToMode "Scroll"; }
        bind "h" "Left" { MoveFocus "Left"; SwitchToMode "Normal"; }
        bind "j" "Down" { MoveFocus "Down"; SwitchToMode "Normal"; }
        bind "k" "Up" { MoveFocus "Up"; SwitchToMode "Normal"; }
        bind "l" "Right" { MoveFocus "Right"; SwitchToMode "Normal"; }
        bind ";" { FocusLastPane; SwitchToMode "Normal"; }
        bind "o" { FocusNextPane; SwitchToMode "Normal"; }
        bind "x" { CloseFocus; SwitchToMode "Normal"; }
        bind "Space" { NextSwapLayout; SwitchToMode "Normal"; }
        bind "b" { ToggleBars; SwitchToMode "Normal"; }
        bind "r" { SwitchToMode "Resize"; }
        bind "g" { SwitchToMode "Locked"; }
        bind "m" {
            Run "cmd.exe" "/d" "/c" "ide.cmd" "--toggle-monitor" {
                background true
            }
            SwitchToMode "Normal"
        }
        bind "?" {
            Run "cmd.exe" "/d" "/c" "ide.cmd" "--toggle-keys" {
                background true
            }
            SwitchToMode "Normal"
        }
        bind "q" {
            Run "ide.cmd" "--quit" {
                floating true
                close_on_exit true
            }
            SwitchToMode "Normal"
        }
        bind "Q" "Shift q" {
            Run "ide.cmd" "--quit" "--force" {
                floating true
                close_on_exit true
            }
            SwitchToMode "Normal"
        }
    }

    resize {
        bind "Esc" "Enter" { SwitchToMode "Normal"; }
        bind "h" "Left" { Resize "Increase Left"; }
        bind "j" "Down" { Resize "Increase Down"; }
        bind "k" "Up" { Resize "Increase Up"; }
        bind "l" "Right" { Resize "Increase Right"; }
        bind "H" { Resize "Decrease Left"; }
        bind "J" { Resize "Decrease Down"; }
        bind "K" { Resize "Decrease Up"; }
        bind "L" { Resize "Decrease Right"; }
        bind "=" "+" { Resize "Increase"; }
        bind "-" { Resize "Decrease"; }
    }

    scroll {
        bind "Esc" "Enter" "q" { SwitchToMode "Normal"; }
        bind "e" { EditScrollback; SwitchToMode "Normal"; }
        bind "/" "s" { SwitchToMode "EnterSearch"; SearchInput 0; }
        bind "Ctrl c" { ScrollToBottom; SwitchToMode "Normal"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl f" "PageDown" "Right" "l" { PageScrollDown; }
        bind "Ctrl b" "PageUp" "Left" "h" { PageScrollUp; }
        bind "d" { HalfPageScrollDown; }
        bind "u" { HalfPageScrollUp; }
        bind "[" { ScrollToPreviousPrompt; }
        bind "]" { ScrollToNextPrompt; }
        bind "m" { SelectCommandAtScrollPosition; }
        bind "c" { CopyLastCommandOutput; SwitchToMode "Normal"; }
    }

    search {
        bind "Esc" "Enter" "q" { SwitchToMode "Normal"; }
        bind "Ctrl c" { ScrollToBottom; SwitchToMode "Normal"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl f" "PageDown" "Right" "l" { PageScrollDown; }
        bind "Ctrl b" "PageUp" "Left" "h" { PageScrollUp; }
        bind "d" { HalfPageScrollDown; }
        bind "u" { HalfPageScrollUp; }
        bind "n" { Search "down"; }
        bind "N" "p" { Search "up"; }
        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "w" { SearchToggleOption "Wrap"; }
        bind "o" { SearchToggleOption "WholeWord"; }
    }

    entersearch {
        bind "Ctrl c" "Esc" { SwitchToMode "Scroll"; }
        bind "Enter" { SwitchToMode "Search"; }
    }

    renametab {
        bind "Ctrl c" "Enter" { SwitchToMode "Normal"; }
        bind "Esc" { UndoRenameTab; SwitchToMode "Normal"; }
    }

    renamepane {
        bind "Ctrl c" "Enter" { SwitchToMode "Normal"; }
        bind "Esc" { UndoRenamePane; SwitchToMode "Normal"; }
    }

    renamesession {
        bind "Ctrl c" "Enter" { SwitchToMode "Normal"; }
        bind "Esc" { UndoRenameSession; SwitchToMode "Normal"; }
    }

    shared_except "locked" {
        // Layer 3 Prefix Entry
        bind "Ctrl b" { SwitchToMode "Tmux"; }

        // Layer 2 Directional Pane Navigation
        bind "Alt h" { MoveFocus "Left"; }
        bind "Alt j" { MoveFocus "Down"; }
        bind "Alt k" { MoveFocus "Up"; }
        bind "Alt l" { MoveFocus "Right"; }

        // Layer 2 Instant IDE Role Jumps & Bounce (<0.1ms native actions)
        bind "Alt a" { MoveFocus "Up"; MoveFocus "Left"; }
        bind "Alt e" { MoveFocus "Up"; MoveFocus "Right"; }
        bind "Alt t" { MoveFocus "Down"; }
        bind "Alt ;" { FocusLastPane; }

        // Layer 2 Session Manager + OSC 7501 Attention Inbox & Session Flipping
        bind "Alt s" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "Normal"
        }
        bind "Alt S" "Alt Shift s" { GoToNextAttention; SwitchToMode "Normal"; }
        bind "Alt [" { GoToPreviousSession; }
        bind "Alt ]" { GoToNextSession; }

        // Layer 2 Zoom, Floating Drawer & Tabs
        bind "Alt z" { ToggleFocusFullscreen; }
        bind "Alt f" "Alt T" "Alt Shift t" { ToggleFloatingPanes; }
        bind "Alt F" "Alt Shift f" { TogglePaneEmbedOrFloating; }
        bind "Alt n" { NewPane; }
        bind "Alt 1" { GoToTab 1; }
        bind "Alt 2" { GoToTab 2; }
        bind "Alt 3" { GoToTab 3; }
        bind "Alt 4" { GoToTab 4; }
        bind "Alt 5" { GoToTab 5; }
        bind "Alt 6" { GoToTab 6; }
        bind "Alt 7" { GoToTab 7; }
        bind "Alt 8" { GoToTab 8; }
        bind "Alt 9" { GoToTab 9; }

        // Layer 2 Pane Resize & Swap
        bind "Alt Left" { Resize "Increase Left"; }
        bind "Alt Down" { Resize "Increase Down"; }
        bind "Alt Up" { Resize "Increase Up"; }
        bind "Alt Right" { Resize "Increase Right"; }
        bind "Alt =" "Alt +" { Resize "Increase"; }
        bind "Alt -" { Resize "Decrease"; }
        bind "Alt H" "Alt Shift h" { MovePane "Left"; }
        bind "Alt J" "Alt Shift j" { MovePane "Down"; }
        bind "Alt K" "Alt Shift k" { MovePane "Up"; }
        bind "Alt L" "Alt Shift l" { MovePane "Right"; }

        // Layer 2 Floating Modals & Safe Workspace Quit
        bind "Alt m" {
            Run "cmd.exe" "/d" "/c" "ide.cmd" "--toggle-monitor" {
                background true
            }
            SwitchToMode "Normal"
        }
        bind "Alt ?" "Alt Shift /" {
            Run "cmd.exe" "/d" "/c" "ide.cmd" "--toggle-keys" {
                background true
            }
            SwitchToMode "Normal"
        }
        bind "Alt q" {
            Run "ide.cmd" "--quit" {
                floating true
                close_on_exit true
            }
            SwitchToMode "Normal"
        }
        bind "Alt Q" "Alt Shift q" {
            Run "ide.cmd" "--quit" "--force" {
                floating true
                close_on_exit true
            }
            SwitchToMode "Normal"
        }
    }
}
