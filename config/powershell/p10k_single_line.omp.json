{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "plain",
          "foreground": "#839496",
          "background": "#073642",
          "template": " {{ if .WSL }}WSL at {{ end }}{{ .Icon }} <#657b83>\uE0B1</>"
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "#268bd2",
          "background": "#073642",
          "template": " \uF07C {{ .Path }} ",
          "properties": {
            "style": "agnoster"
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#859900",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#b58900{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#cb4b16{{ end }}",
            "{{ if gt .Ahead 0 }}#2aa198{{ end }}",
            "{{ if gt .Behind 0 }}#859900{{ end }}"
          ],
          "background": "#073642",
          "template": "<#657b83>\uE0B1</> {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uF044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uF046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \uEB4B {{ .StashCount }}{{ end }} "
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#073642",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#dc322f{{ end }}"
          ],
          "background": "transparent",
          "template": "\uE0B0"
        }
      ]
    },
    {
      "type": "rprompt",
      "segments": [
        {
          "type": "node",
          "style": "diamond",
          "invert_powerline": true,
          "leading_diamond": "\uE0B2",
          "trailing_diamond": "",
          "foreground": "#859900",
          "background": "#073642",
          "template": " {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} \uE718 "
        },
        {
          "type": "go",
          "style": "diamond",
          "invert_powerline": true,
          "leading_diamond": "\uE0B2",
          "trailing_diamond": "",
          "foreground": "#2aa198",
          "background": "#073642",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} \uE627 "
        },
        {
          "type": "python",
          "style": "diamond",
          "invert_powerline": true,
          "leading_diamond": "\uE0B2",
          "trailing_diamond": "",
          "foreground": "#b58900",
          "background": "#073642",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} \uE235 "
        },
        {
          "type": "dotnet",
          "style": "diamond",
          "invert_powerline": true,
          "leading_diamond": "\uE0B2",
          "trailing_diamond": "",
          "foreground": "#6c71c4",
          "background": "#073642",
          "template": " {{ if .Unsupported }}\uF071{{ else }}{{ .Full }}{{ end }} \uE70C "
        },
        {
          "type": "rust",
          "style": "diamond",
          "invert_powerline": true,
          "leading_diamond": "\uE0B2",
          "trailing_diamond": "",
          "foreground": "#cb4b16",
          "background": "#073642",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} \uE7A8 "
        },
        {
          "type": "aws",
          "style": "diamond",
          "invert_powerline": true,
          "leading_diamond": "\uE0B2",
          "trailing_diamond": "",
          "foreground": "#93a1a1",
          "background": "#073642",
          "foreground_templates": [
            "{{if contains \"default\" .Profile}}#cb4b16{{end}}"
          ],
          "template": " {{ .Profile }}{{ if .Region }}@{{ .Region }}{{ end }} \uE7AD "
        },
        {
          "type": "root",
          "style": "diamond",
          "invert_powerline": true,
          "leading_diamond": "\uE0B2",
          "trailing_diamond": "",
          "foreground": "#dc322f",
          "background": "#073642",
          "template": " \uF0AD "
        },
        {
          "type": "executiontime",
          "style": "diamond",
          "invert_powerline": true,
          "leading_diamond": "\uE0B2",
          "trailing_diamond": "",
          "foreground": "#b58900",
          "background": "#073642",
          "template": " {{ .FormattedMs }} \uF252 "
        },
        {
          "type": "status",
          "style": "diamond",
          "invert_powerline": true,
          "leading_diamond": "\uE0B2",
          "trailing_diamond": "",
          "foreground": "#93a1a1",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#dc322f{{ end }}"
          ],
          "background": "#073642",
          "template": " {{ if gt .Code 0 }}{{ reason .Code }}{{ else }}\uF42E{{ end }} "
        }
      ]
    }
  ]
}
