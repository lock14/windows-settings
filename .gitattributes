# Auto-detect text files and normalize line endings to LF by default
* text=auto eol=lf

# Windows scripts and batch files MUST retain CRLF (required by cmd.exe after chcp 65001)
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.doskey text eol=crlf

# Declarative configs, queries, themes, workflows, and documentation use LF
*.md text eol=lf
*.json text eol=lf
*.kdl text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.rs text eol=lf
*.lua text eol=lf
*.scm text eol=lf
*.theme text eol=lf
*.tmTheme text eol=lf
*.sublime-syntax text eol=lf
*.gitconfig text eol=lf
*.conf text eol=lf
*.txt text eol=lf
LICENSE text eol=lf
